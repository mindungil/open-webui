# =========================================
# openwebui.conf  (FULL STREAM MODE + safe rewrite)
# =========================================

# ---------- Upstreams ----------
upstream openwebui_backend {
    server 127.0.0.1:8080 max_fails=3 fail_timeout=10s;
    keepalive 64;
}
upstream oss_sglang {
    server 192.168.0.201:30010 max_fails=3 fail_timeout=10s;
    keepalive 64;
}
upstream deep_sglang {
    server 192.168.0.201:30020 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

# ---------- Helpers ----------
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

log_format sse_timing '$remote_addr - $request $status bytes=$body_bytes_sent '
                      'rt=$request_time urt=$upstream_response_time uaddr=$upstream_addr';

server {

    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ai.jb.go.kr;
    return 301 https://$host$request_uri;
}

server {

    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ai.jb.go.kr;

    ssl_certificate		/etc/nginx/ssl/cert.crt;
    ssl_certificate_key		/etc/nginx/ssl/cert-nopass.key;

    ssl_session_timeout		60m;
    ssl_protocols		TLSv1.2 TLSv1.3;
    ssl_ciphers			HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers	on;
    
    root /var/www/openwebui;
    index index.html;

    server_tokens off;
    sendfile off;
    tcp_nopush on;
    tcp_nodelay on;
    client_max_body_size 10g;

    # 전역 proxy 헤더 및 공통 설정
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";


    # ---- CORS headers (server-scope) ----
    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET,POST,PUT,DELETE,OPTIONS" always;
    add_header Access-Control-Allow-Headers $http_access_control_request_headers always;


    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    gzip off;

    # ==================================================
    # (1) OSS 모델군
    # ==================================================
    location ~* ^/v1-oss/(chat/completions|completions|responses)(/.*)?$ {
        rewrite ^/v1-oss/(.*)$ /v1/$1 last;
        proxy_pass http://oss_sglang;
        proxy_hide_header Content-Length;
        add_header X-Accel-Buffering no always;
        add_header Cache-Control "no-cache" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

	proxy_buffering off;
	proxy_set_header Accept "text/event-stream";
	proxy_set_header Cache-Control "no-cache";
	proxy_set_header Accept-Encoding "";

        access_log /var/log/nginx/access_sse.log sse_timing;
    }

    location ~* ^/v1-oss/(.*)$ {
        rewrite ^/v1-oss/(.*)$ /v1/$1 last;
        proxy_pass http://oss_sglang;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ==================================================
    # (2) DeepSeek 모델군
    # ==================================================
    location ~* ^/v1-deep/(chat/completions|completions|responses)(/.*)?$ {
        rewrite ^/v1-deep/(.*)$ /v1/$1 last;
        proxy_pass http://deep_sglang;
        proxy_hide_header Content-Length;
        add_header X-Accel-Buffering no always;
        add_header Cache-Control "no-cache" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

	proxy_buffering off;
	proxy_set_header Accept "text/event-stream";
	proxy_set_header Cache-Control "no-cache";
	proxy_set_header Accept-Encoding "";

        access_log /var/log/nginx/access_sse.log sse_timing;
    }

    location ~* ^/v1-deep/(.*)$ {
        rewrite ^/v1-deep/(.*)$ /v1/$1 last;
        proxy_pass http://deep_sglang;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ==================================================
    # (3) OpenWebUI API 및 정적 리소스
    # ==================================================
    location ^~ /api/chat/completions {
        proxy_pass http://openwebui_backend;
        proxy_hide_header Content-Length;
        add_header X-Accel-Buffering no always;
        add_header Cache-Control "no-cache" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

	proxy_buffering off;
	proxy_set_header Accept "text/event-stream";
	proxy_set_header Cache-Control "no-cache";
	proxy_set_header Accept-Encoding "";

        access_log /var/log/nginx/access_sse.log sse_timing;
    }

    location ^~ /api/ {
	if ($request_method = OPTIONS) { return 204; }

        proxy_pass http://openwebui_backend;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /api/files/ {
        proxy_pass http://openwebui_backend;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # WebSocket
    location /socket.io/ {

	if ($request_method = OPTIONS) { return 204; }

        proxy_pass http://openwebui_backend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

	proxy_http_version 1.1;

        proxy_buffering off;
        proxy_cache off;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Conduit (모바일) 호환용 WebSocket 프록시
    location /ws/socket.io/ {

	if ($request_method = OPTIONS) { return 204; }

        # rewrite to standard Socket.IO path
        rewrite ^/ws/socket.io/(.*)$ /socket.io/$1 last;
        rewrite ^/ws/socket.io$ /socket.io/ last;

        proxy_pass http://openwebui_backend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

	proxy_http_version 1.1;

        proxy_buffering off;
        proxy_cache off;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }


    # 정적 리소스
    location /static/ {
        root /var/www/openwebui;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|otf)$ {
        root /var/www/openwebui;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html { add_header Cache-Control "no-cache"; }

    # React SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }


    # 보안 헤더
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

